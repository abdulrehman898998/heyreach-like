{
  "name": "heyreach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "test:api": "vitest tests/api/",
    "test:integration": "vitest tests/integration/",
    "test:unit": "vitest tests/unit/",
    "test:e2e": "vitest tests/e2e/",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "lint": "pnpm --recursive lint",
    "db:push": "pnpm --filter web-api db:push",
    "db:seed": "pnpm --filter web-api db:seed",
    "docker:up": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:test:up": "docker-compose -f docker/docker-compose.test.yml up --build -d",
    "docker:test:down": "docker-compose -f docker/docker-compose.test.yml down",
    "docker:test:logs": "docker-compose -f docker/docker-compose.test.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^8.57.0",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "@faker-js/faker": "^9.3.1",
    "axios": "^1.7.9"
  },
  "packageManager": "pnpm@8.15.0"
}
