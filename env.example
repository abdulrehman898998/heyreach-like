# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/heyreach

# Redis
REDIS_URL=redis://localhost:6379

# S3 (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=heyreach-artifacts
S3_REGION=us-east-1

# App
APP_URL=http://localhost:3000
JWT_SECRET=change_me
COOKIE_ENC_KEY_BASE64= # base64 32-byte key for AES-GCM

# Playwright
PLAYWRIGHT_HEADLESS=true
DEFAULT_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
DEFAULT_TIMEZONE=Europe/London
DEFAULT_LOCALE=en-GB

# MCP
MCP_URL=http://mcp:8080/analyze
MCP_API_KEY=

# Proxy/IP Intel
REQUIRE_RESIDENTIAL=true
ALLOW_MOBILE=true
ALLOW_DATACENTER=false
ASN_DENYLIST=16509,13335,15169,16276,14061,14618  # AWS, Cloudflare, Google, OVH, DigitalOcean, Amazon
IP_INTEL_CACHE_TTL=1800                # seconds
PROXY_HEALTH_TIMEOUT_MS=2500
MAX_PROXY_ROTATIONS_PER_24H=1
RISK_PAUSE_THRESHOLD=60
